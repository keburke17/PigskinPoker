{
  "name": "pigskin-poker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pigskin Poker - a custom fantasy-football league game.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "link": "node scripts/magic-link.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node scripts/test.mjs",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:generate": "node scripts/generate-seed.mjs",
    "pool:sql": "node scripts/generate-pool-migration.mjs",
    "seed:accounts": "node scripts/seed-accounts.mjs",
    "db:reset": "supabase db reset && node scripts/seed-accounts.mjs",
    "db:push": "supabase db push && node scripts/verify-grants.mjs",
    "verify:grants": "node scripts/verify-grants.mjs",
    "verify:email": "node scripts/verify-email.mjs",
    "verify:redirects": "node scripts/verify-redirects.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "supabase": "^2.114.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
