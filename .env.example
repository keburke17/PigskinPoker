# Copy to .env.local and fill in. .env* is git-ignored (except this file).
# Values come from the Supabase dashboard: Settings -> API Keys.
# Phase 1 does not read any of these; the in-memory adapter needs no configuration.

# Public by design - ships to every browser.
VITE_SUPABASE_URL=https://wzzrxoslcwpyopdvvxmn.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SERVER-SIDE ONLY. Bypasses RLS. Never prefix with VITE_ (that would ship it to
# the browser), never commit it, never paste it into a chat window.
SUPABASE_SECRET_KEY=sb_secret_...

# OPTIONAL. A pepper for the login rate limiter's IP buckets, so auth_throttle stores
# hashes rather than addresses. If unset it falls back to SUPABASE_SECRET_KEY, which
# works fine - the only consequence is that rotating the secret key re-buckets whoever
# is mid-attempt, costing one 15-minute window of counting. Set it if you would rather
# the two were independent.
# AUTH_IP_PEPPER=
